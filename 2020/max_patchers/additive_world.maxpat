									"code" : "t = in1;\r\nenv = in2;\r\n\r\nvib = cycle(8);\r\n\r\ntrig = change(change(env)) > 0;\r\n\r\nfundamental = latch(ceil(abs(noise()*6 + 4)*30), trig);\r\n\r\nvoices = 6;\r\nsum = 0;\r\nfor (i=0; i<voices; i+=1) {\r\n\tp = i/voices;\r\n\t\r\n\tfreq = fundamental * pow(2,i); //pow(i,2); //(i*2+2);\r\n\tgain = pow(env, 4*p);\r\n\t\r\n\tpm = 0.1*sin(twopi * t*(5+pow(1.1,i)));\r\n\r\n\tsum += gain * sin(twopi * (t * freq + pm));\r\n}\r\n\r\nout1 = sum/voices;\r\nout2 = change(change(env));",
